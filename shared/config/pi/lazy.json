{
  "version": 1,
  "defaults": {
    "lazy": true
  },
  "auto": true,
  "autoLoadLimit": 1,
  "afterStartBatchSize": 1,
  "afterStartDelayMs": 0,
  "afterStartInitialDelayMs": 750,
  "afterStartPauseDuringTurn": true,
  "afterStartAdaptiveYield": true,
  "afterStartPrefetch": true,
  "specs": [
    {
      "name": "hermes-memory",
      "source": "npm:pi-hermes-memory",
      "lazy": true,
      "tools": [
        "memory_search",
        "memory_add",
        "memory_replace",
        "memory_remove",
        "skill_manage"
      ],
      "keywords": [
        "remember this",
        "memory search",
        "previous session"
      ],
      "description": "Persistent memory and session indexing"
    },
    {
      "name": "subagents",
      "source": "npm:@tintinweb/pi-subagents",
      "lazy": true,
      "tools": [
        "Agent",
        "SubagentWorkflow",
        "get_subagent_result",
        "steer_subagent"
      ],
      "keywords": [
        "subagent",
        "delegate task",
        "workflow"
      ],
      "description": "Subagent orchestration"
    },
    {
      "name": "ask-user",
      "source": "npm:@juicesharp/rpiv-ask-user-question",
      "lazy": true,
      "tools": [
        "ask_user_question"
      ],
      "keywords": [
        "ask a question",
        "clarify requirements"
      ]
    },
    {
      "name": "todo",
      "source": "npm:@juicesharp/rpiv-todo",
      "lazy": true,
      "tools": [
        "todo"
      ],
      "keywords": [
        "task list",
        "todo list"
      ]
    },
    {
      "name": "ultra-compact",
      "source": "npm:pi-ultra-compact",
      "lazy": true,
      "keywords": [
        "compact context",
        "ultracompact"
      ],
      "description": "Enhanced context compaction"
    },
    {
      "name": "fff",
      "source": "npm:@ff-labs/pi-fff",
      "lazy": "after-start",
      "priority": 10,
      "description": "Fuzzy file and content search"
    },
    {
      "name": "image-view",
      "source": "npm:pi-image-view",
      "lazy": "after-start",
      "priority": 20,
      "cmd": [
        "pi-image-view"
      ],
      "description": "Clipboard image previews and stable image references"
    },
    {
      "name": "web",
      "source": "npm:pi-web-access",
      "lazy": true,
      "cmd": [
        "web"
      ],
      "tools": [
        "web_search",
        "fetch_content",
        "get_search_content"
      ],
      "keywords": [
        "web search",
        "search the web",
        "fetch url",
        "youtube"
      ],
      "description": "Web search, page fetches, and video analysis"
    },
    {
      "name": "mcp",
      "source": "npm:pi-mcp-adapter",
      "lazy": true,
      "cmd": [
        "mcp"
      ],
      "keywords": [
        "mcp",
        "playwright",
        "clickup",
        "linear",
        "datadog",
        "dd",
        "issue",
        "ticket",
        "bug",
        "incident",
        "monitoring",
        "logs",
        "metrics"
      ],
      "description": "MCP server bridge"
    },
    {
      "name": "context-mode",
      "source": "npm:context-mode",
      "lazy": true,
      "cmd": [
        "context-mode",
        "ctx"
      ],
      "tools": [
        "ctx_execute",
        "ctx_search",
        "ctx_index"
      ],
      "keywords": [
        "context-mode",
        "ctx_execute"
      ],
      "description": "Context-preserving data-processing tools"
    },
    {
      "name": "lens",
      "source": "npm:pi-lens",
      "lazy": true,
      "cmd": [
        "lens"
      ],
      "tools": [
        "lens_diagnostics",
        "symbol_search",
        "module_report",
        "lsp_diagnostics"
      ],
      "keywords": [
        "diagnostics",
        "symbol search",
        "ast-grep",
        "lsp"
      ],
      "description": "Code intelligence and diagnostics"
    },
    {
      "name": "btw",
      "source": "npm:pi-btw",
      "lazy": true,
      "cmd": [
        "btw"
      ],
      "keywords": [
        "side conversation"
      ],
      "description": "Parallel side conversation"
    },
    {
      "name": "intercom",
      "source": "npm:pi-intercom",
      "lazy": true,
      "tools": [
        "intercom"
      ],
      "keywords": [
        "intercom",
        "other pi session"
      ],
      "description": "Local Pi session coordination"
    },
    {
      "name": "cmux",
      "source": "npm:pi-cmux",
      "lazy": "after-start",
      "tools": [
        "cmux_open_terminal"
      ],
      "keywords": [
        "cmux",
        "terminal pane",
        "terminal tab"
      ],
      "description": "cmux terminal integration"
    },
    {
      "name": "plan-mode",
      "source": "npm:@narumitw/pi-plan-mode",
      "lazy": true,
      "cmd": [
        "plan"
      ],
      "keywords": [
        "plan mode",
        "read-only plan"
      ],
      "description": "Read-only planning workflow"
    },
    {
      "name": "sessions",
      "source": "npm:pi-sessions",
      "lazy": "after-start",
      "tools": [
        "session_search",
        "session_reachable",
        "session_send_message",
        "session_cancel",
        "create_handoff_context",
        "session_handoff",
        "session_ask"
      ],
      "keywords": [
        "search past sessions",
        "session handoff",
        "session history"
      ],
      "description": "Session search, handoff, and messaging"
    }
  ]
}
